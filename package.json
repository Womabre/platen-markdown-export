{
  "name": "platen-markdown-export",
  "version": "1.0.3",
  "description": "Converts Markdown to print-quality PDF via WeasyPrint, with swappable themes: cover pages, running headers/footers, revision tables and a rebuilt table of contents.",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "platen-markdown-export": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "test": "node scripts/run-tests.js",
    "pretest": "npm run build",
    "lint": "eslint src",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check:versions && npm run lint && npm test",
    "check:versions": "node scripts/check-versions.js",
    "check:changelog": "node scripts/check-changelog.js",
    "check": "npm run check:versions && npm run check:changelog && npm run lint && npm test && npm run verify:pdf",
    "test:coverage": "npm run build && node scripts/run-tests.js --coverage",
    "version:set": "node scripts/set-version.js",
    "verify:pdf": "npm run build && node scripts/verify-pdf-export.js",
    "verify:pdf:all": "npm run build && node scripts/verify-pdf-export.js --all-themes",
    "verify:samples": "npm run build && node scripts/verify-pdf-export.js --samples",
    "brand": "node scripts/brand-svgs.js"
  },
  "dependencies": {
    "@antv/infographic": "0.2.20",
    "@hpcc-js/wasm-graphviz": "1.29.0",
    "@traptitech/markdown-it-katex": "3.6.0",
    "front-matter": "4.0.2",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.6",
    "markdown-it": "15.0.1",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-container": "4.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.17.2",
    "sharp": "0.35.4"
  },
  "optionalDependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "markdown",
    "pdf",
    "weasyprint",
    "html",
    "documentation",
    "print",
    "themes",
    "cover-page",
    "mermaid",
    "markdown-to-pdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Womabre/platen-markdown-export.git"
  },
  "bugs": {
    "url": "https://github.com/Womabre/platen-markdown-export/issues"
  },
  "homepage": "https://github.com/Womabre/platen-markdown-export#readme",
  "files": [
    "dist/",
    "!dist/tests/",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "themes/",
    "!themes/**/sample*_Rev*.html",
    "!themes/**/sample*_Rev*.pdf",
    "assets/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
