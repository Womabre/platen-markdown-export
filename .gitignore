# Build output
dist/
built/

# Dependencies
node_modules/

# Packaged artifacts
*.vsix
*.tgz

# Rendered sample outputs — regenerated by exporting themes/*/sample *.md,
# so they are deliberately not versioned (each self-contained .html inlines
# its fonts and images and runs to ~25 MB).
sample*_Rev*.html
sample*_Rev*.pdf

# Intermediate file kept by --mode debug
*_tmp-*.html

# Local runtime scratch that lands in the project root: a Python venv from a
# manual WeasyPrint install, and a literal "$HOME" directory created by an
# unquoted variable in some external tool. Neither belongs to this project;
# both are safe to delete.
.v/
$HOME/

# Tooling / editor
.eslintcache
coverage/
*.code-workspace
.vscode/
.idea/
.claude/
**/.DS_Store

# Afinity Logo files
*.af
*.af~lock~

# ignored folders
ignore*/
