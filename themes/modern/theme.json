        "Guava"           : { "image": "hero/modern-hero-guava.webp",        "palette": "Guava",        "overlay": [0.5, 1], "attribution": "Photo by Yuliia Martsynkevych https://unsplash.com/@yumartsy?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" },
        "Dragonfruit"     : { "image": "hero/modern-hero-dragonfruit.webp",  "palette": "Dragonfruit",  "overlay": [0.5, 1], "attribution": "Photo by Zoshua Colah https://unsplash.com/@zoshuacolah?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" },
