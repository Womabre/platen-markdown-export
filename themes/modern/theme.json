        "Blueberry"       : { "image": "hero/modern-hero-blueberry.webp",    "palette": "Blueberry",    "overlay": [0.5, 1], "attribution": "Photo by Melissa Belanger https://unsplash.com/@melissabelanger?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" },
        "Lime"            : { "image": "hero/modern-hero-lime.webp",         "palette": "Lime",         "overlay": [0.5, 1], "attribution": "Photo by Vino Li https://unsplash.com/@vinomamba24?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" },
